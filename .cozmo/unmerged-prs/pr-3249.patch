+    public Result<Void> reportDeviceEvent(@RequestBody DeviceEventReportDTO dto) {
+        if (dto == null || StringUtils.isBlank(dto.getDeviceId()) || StringUtils.isBlank(dto.getEvent())) {
+            return new Result<Void>().error("参数错误");
