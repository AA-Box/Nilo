+
+export interface PubConfig {
+    version: string
+    beianIcpNum: string | null
+    beianGaNum: string | null
+    allowUserRegister: boolean
+    enableMobileRegister?: boolean
+    mobileAreaList?: MobileAreaItem[]
+}
+
+export interface RootState {
+    token: string
+    userInfo: UserInfo
+    isSuperAdmin: boolean
+    pubConfig: PubConfig
+}
