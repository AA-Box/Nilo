+`main/manager-api/src/main/resources/db/changelog/202606281000.sql`:
+```sql
+-- 用户-陪伴角色匹配映射(儿童陪伴:按聊天主题自动匹配角色 + 家长手动切换)
+CREATE TABLE `ai_user_persona_assignment` (
