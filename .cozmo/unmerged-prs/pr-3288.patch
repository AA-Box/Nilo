+        UserPersonaAssignmentEntity e = getByUserId(userId);
+        if (e == null) {
+            e = new UserPersonaAssignmentEntity();
+            e.setUserId(userId);
+        }
+        e.setAgentId(agentId);
+        e.setScore(score);
+        e.setReason(reason);
+        e.setManual(0);
+        e.setMatchedAt(new Date());
+        this.saveOrUpdate(e);
+    }
+
+    @Override
+    public void setManual(Long userId, String agentId) {
+        UserPersonaAssignmentEntity e = getByUserId(userId);
+        if (e == null) {
+            e = new UserPersonaAssignmentEntity();
+            e.setUserId(userId);
+        }
+        e.setAgentId(agentId);
+        e.setManual(1);
+        e.setReason("manual");
+        e.setMatchedAt(new Date());
+        this.saveOrUpdate(e);
+    }
+
+    @Override
+    public void resetAuto(Long userId) {
+        UserPersonaAssignmentEntity e = getByUserId(userId);
+        if (e != null) {
+            e.setManual(0);
