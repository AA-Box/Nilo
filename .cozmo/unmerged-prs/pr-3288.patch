+
+    # 默认使用火山引擎豆包配置
+    config = {
+        "retrieval_mode": "fts5",
+        "sqlite": {"path": "./data/test_llm_memory.db"},
+        "llm": {
+            "provider": "openai",
+            # 火山引擎豆包（默认）
+            "api_key": os.getenv("ARK_API_KEY", "6202d63d-377b-4bd7-a2ad-c162ed977c24"),
