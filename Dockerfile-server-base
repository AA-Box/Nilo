# kivo-server base image: system libraries + Python dependencies.
# Rebuilt only when main/kivo-server/requirements.txt changes (see .github/workflows/build-base-image.yml).
FROM python:3.12-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends libopus0 ffmpeg && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONIOENCODING=utf-8 \
    PIP_DEFAULT_TIMEOUT=120

WORKDIR /opt/kivo-server

COPY main/kivo-server/requirements.txt .

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt --retries 5
